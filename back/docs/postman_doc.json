{
  "info": {
    "name": "FocusArc API",
    "_postman_id": "focusarc-api-v1",
    "description": "FocusArc REST API — productivity app with a User → Arc → Chapter → Task hierarchy.\n\n**Quick start**\n1. Send `POST /auth/register` or `POST /auth/login` — the `accessToken` and `refreshToken` variables are saved automatically.\n2. Every other request inherits `Bearer {{accessToken}}` from the collection.\n3. User endpoints (`GET /users`, `PUT /users`, `DELETE /users`) operate on the authenticated user — no ID in the URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:8080/api", "type": "string" },
    { "key": "accessToken",  "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "arcId",        "value": "00000000-0000-0000-0000-000000000002", "type": "string" },
    { "key": "chapterId",    "value": "00000000-0000-0000-0000-000000000003", "type": "string" },
    { "key": "taskId",       "value": "00000000-0000-0000-0000-000000000004", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Public endpoints — no Bearer token required.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken)  pm.collectionVariables.set('accessToken',  res.accessToken);",
                  "if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Create a new account. Returns `accessToken` (15 min) and `refreshToken` (7 days). Both are saved automatically to collection variables.\n\n**Validations**\n- `name`: required\n- `email`: required, valid email, unique\n- `password`: required, min 8 chars\n\n**Responses**\n- `201 Created` — registration successful\n- `409 Conflict` — email already in use"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken)  pm.collectionVariables.set('accessToken',  res.accessToken);",
                  "if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate with email and password. Tokens are saved automatically.\n\n**Responses**\n- `200 OK` — login successful\n- `401 Unauthorized` — invalid credentials"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken)  pm.collectionVariables.set('accessToken',  res.accessToken);",
                  "if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Exchange a refresh token for a new access + refresh token pair. New tokens are saved automatically.\n\n**Responses**\n- `200 OK` — tokens refreshed\n- `401 Unauthorized` — token invalid or expired"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "description": "Authenticated user management. All endpoints operate on the caller — no `{id}` in the URL. Requires `Bearer {{accessToken}}`.",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Returns the authenticated user.\n\n**Responses**\n- `200 OK`\n- `401 Unauthorized`\n- `404 Not Found`"
          },
          "response": []
        },
        {
          "name": "Update Current User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Smith\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Partial update — only `name` is updatable. Null fields are ignored.\n\n**Responses**\n- `200 OK`\n- `400 Bad Request` — validation failure\n- `401 Unauthorized`"
          },
          "response": []
        },
        {
          "name": "Delete Current User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Permanently deletes the authenticated user.\n\n**Responses**\n- `204 No Content`\n- `401 Unauthorized`"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Arcs",
      "description": "Arc management. An arc is a multi-week focus span. A user can have at most **one ACTIVE arc** at a time.",
      "item": [
        {
          "name": "Create Arc",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Q1 Deep Work\",\n  \"totalEstimatedMinutes\": 600\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/arcs",
              "host": ["{{baseUrl}}"],
              "path": ["arcs"]
            },
            "description": "Create a new arc. The owner is automatically set to the authenticated user.\n\n**Validations**\n- `name`: required, non-blank\n- `totalEstimatedMinutes`: required, positive\n\n**Responses**\n- `201 Created`\n- `400 Bad Request` — validation failure or user already has an active arc\n- `401 Unauthorized`"
          },
          "response": []
        },
        {
          "name": "Get Arc by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/arcs/{{arcId}}",
              "host": ["{{baseUrl}}"],
              "path": ["arcs", "{{arcId}}"]
            },
            "description": "**Responses**\n- `200 OK`\n- `401 Unauthorized`\n- `404 Not Found`"
          },
          "response": []
        },
        {
          "name": "Get All Arcs (current user)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/arcs/me",
              "host": ["{{baseUrl}}"],
              "path": ["arcs", "me"]
            },
            "description": "Returns all arcs owned by the authenticated user.\n\n**Responses**\n- `200 OK` — list of arcs\n- `204 No Content` — no arcs found\n- `401 Unauthorized`"
          },
          "response": []
        },
        {
          "name": "Update Arc",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Q1 Deep Work — Updated\",\n  \"totalEstimatedMinutes\": 900\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/arcs/{{arcId}}",
              "host": ["{{baseUrl}}"],
              "path": ["arcs", "{{arcId}}"]
            },
            "description": "Partial update — all fields optional, null fields are ignored.\n\n**Responses**\n- `200 OK`\n- `400 Bad Request` — validation failure\n- `401 Unauthorized`\n- `404 Not Found`"
          },
          "response": []
        },
        {
          "name": "Delete Arc",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/arcs/{{arcId}}",
              "host": ["{{baseUrl}}"],
              "path": ["arcs", "{{arcId}}"]
            },
            "description": "**Responses**\n- `204 No Content`\n- `401 Unauthorized`\n- `404 Not Found`"
          },
          "response": []
        },
        {
          "name": "Delete All Arcs (current user)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/arcs",
              "host": ["{{baseUrl}}"],
              "path": ["arcs"]
            },
            "description": "Deletes all arcs owned by the authenticated user.\n\n**Responses**\n- `204 No Content`\n- `401 Unauthorized`"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Chapters",
      "description": "Chapter management. A chapter represents a single calendar day within an arc. At most **one chapter per arc per date**.",
      "item": [
        {
          "name": "Create Chapter",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"arcId\": \"{{arcId}}\",\n  \"estimatedMinutes\": 120,\n  \"scheduledDate\": \"2026-03-15\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/chapters",
              "host": ["{{baseUrl}}"],
              "path": ["chapters"]
            },
            "description": "Create a chapter for a given arc.\n\n**Validations**\n- `arcId`: required (UUID)\n- `estimatedMinutes`: required, positive\n- `scheduledDate`: today or future, format `YYYY-MM-DD`\n\n**Responses**\n- `201 Created`\n- `400 Bad Request` — a chapter already exists for that arc + date\n- `401 Unauthorized`\n- `404 Not Found` — arc not found"
          },
          "response": []
        },
        {
          "name": "Get Chapter by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chapters/{{chapterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chapters", "{{chapterId}}"]
            },
            "description": "**Responses**\n- `200 OK`\n- `401 Unauthorized`\n- `404 Not Found`"
          },
          "response": []
        },
        {
          "name": "Get All Chapters for Arc",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chapters/arcs/{{arcId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chapters", "arcs", "{{arcId}}"]
            },
            "description": "**Responses**\n- `200 OK` — list of chapters\n- `204 No Content` — arc has no chapters\n- `401 Unauthorized`"
          },
          "response": []
        },
        {
          "name": "Update Chapter",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledDate\": \"2026-03-20\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/chapters/{{chapterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chapters", "{{chapterId}}"]
            },
            "description": "`scheduledDate` must be strictly in the future.\n\n**Responses**\n- `200 OK`\n- `400 Bad Request` — validation failure\n- `401 Unauthorized`\n- `404 Not Found`"
          },
          "response": []
        },
        {
          "name": "Delete Chapter",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/chapters/{{chapterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chapters", "{{chapterId}}"]
            },
            "description": "**Responses**\n- `204 No Content`\n- `401 Unauthorized`\n- `404 Not Found`"
          },
          "response": []
        },
        {
          "name": "Delete All Chapters for Arc",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/chapters/arcs/{{arcId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chapters", "arcs", "{{arcId}}"]
            },
            "description": "**Responses**\n- `204 No Content`\n- `401 Unauthorized`"
          },
          "response": []
        },
        {
          "name": "Get Today's Chapter Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chapters/summary",
              "host": ["{{baseUrl}}"],
              "path": ["chapters", "summary"]
            },
            "description": "Returns today's chapter summary for the authenticated user's active arc, including pending tasks and remaining time. The user is resolved from the JWT — no query parameter needed.\n\n**Responses**\n- `200 OK` — summary with tasks\n- `400 Bad Request` — no active arc\n- `401 Unauthorized`\n- `404 Not Found` — no chapter for today"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tasks",
      "description": "Task management. Tasks are discrete work blocks within a chapter with estimated and completed minutes.",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chapterId\": \"{{chapterId}}\",\n  \"estimatedMinutes\": 45,\n  \"scheduledAt\": \"2026-03-15T10:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            },
            "description": "Create a task within a chapter.\n\n**Validations**\n- `chapterId`: required (UUID)\n- `estimatedMinutes`: required, positive, max 1440\n- `scheduledAt`: now or future, ISO 8601 instant (`YYYY-MM-DDTHH:mm:ssZ`)\n\n**Responses**\n- `201 Created`\n- `400 Bad Request` — validation failure\n- `401 Unauthorized`\n- `404 Not Found` — chapter not found"
          },
          "response": []
        },
        {
          "name": "Get Task by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "**Responses**\n- `200 OK`\n- `401 Unauthorized`\n- `404 Not Found`"
          },
          "response": []
        },
        {
          "name": "Get All Tasks for Chapter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks/chapters/{{chapterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "chapters", "{{chapterId}}"]
            },
            "description": "**Responses**\n- `200 OK` — list of tasks\n- `204 No Content` — chapter has no tasks\n- `401 Unauthorized`"
          },
          "response": []
        },
        {
          "name": "Get Today's Tasks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks/today",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "today"]
            },
            "description": "Returns all tasks for today's chapter of the authenticated user's active arc. User resolved from JWT.\n\n**Responses**\n- `200 OK`\n- `204 No Content` — no tasks today\n- `401 Unauthorized`"
          },
          "response": []
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estimatedMinutes\": 60,\n  \"scheduledAt\": \"2026-03-15T11:00:00Z\",\n  \"taskStatus\": \"IN_PROGRESS\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "Partial update — all fields optional, null fields are ignored. Triggers recalculation if estimated or completed minutes change.\n\n**`taskStatus` values**: `PLANNED`, `IN_PROGRESS`, `DONE`, `SKIPPED`\n\n**Responses**\n- `200 OK`\n- `400 Bad Request` — validation failure\n- `401 Unauthorized`\n- `404 Not Found`"
          },
          "response": []
        },
        {
          "name": "Complete Task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completedMinutes\": 42\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}", "complete"]
            },
            "description": "Mark a task as `DONE` and record actual completed minutes. Triggers recalculation of chapter and arc totals.\n\n**Validations**\n- `completedMinutes`: required, positive, max 1440\n\n**Responses**\n- `200 OK`\n- `400 Bad Request` — task already completed, or completedMinutes out of range\n- `401 Unauthorized`\n- `404 Not Found`"
          },
          "response": []
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            },
            "description": "**Responses**\n- `204 No Content`\n- `401 Unauthorized`\n- `404 Not Found`"
          },
          "response": []
        },
        {
          "name": "Delete All Tasks for Chapter",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/tasks/chapters/{{chapterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "chapters", "{{chapterId}}"]
            },
            "description": "**Responses**\n- `204 No Content`\n- `401 Unauthorized`"
          },
          "response": []
        }
      ]
    }
  ]
}